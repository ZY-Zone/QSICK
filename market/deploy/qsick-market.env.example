# QSICK market runtime environment. Keep this file root-only (chmod 600).
QSICK_MARKET_HOST=127.0.0.1
QSICK_MARKET_PORT=8787
QSICK_MARKET_DB=/var/lib/qsick-market/market.db
# 上传的插件归档；systemd unit 已允许写 /var/lib/qsick-market。
QSICK_MARKET_FILES=/var/lib/qsick-market/files
# 生成 archive_url 的公开基址；留空时按请求 Host 推导。
QSICK_MARKET_PUBLIC_BASE=http://sickcc.online/QSICK/plugins-market
# 脚本/自动化发布使用的 token。
QSICK_MARKET_TOKEN=replace-me
# 管理界面密码的 PBKDF2-SHA256 哈希；留空则管理界面不可登录。
QSICK_MARKET_ADMIN_HASH=
# 管理员会话 Cookie 的 HMAC 密钥；必须是随机长字符串。
QSICK_MARKET_ADMIN_SECRET=
